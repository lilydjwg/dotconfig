{
  "idle_inhibitor": {
    "cursor": false,
    "format": "{icon}",
    "format-icons": {
      "activated": "",
      "deactivated": ""
    }
  },
  "clock": {
    "format": "{:L%Y-%m-%d %H:%M:%S %A}",
    "tooltip-format": "<span font=\"文泉驿等宽正黑 11\">      {:%Y %B}\n\n{calendar}</span>",
    "interval": 1,
  },
  "memory": {
    "format": "MEM {}<span color='gray'>%</span>"
  },
  "temperature": {
    // "thermal-zone": 2,
    // "hwmon-path": "/sys/class/hwmon/hwmon2/temp1_input",
    "critical-threshold": 90,
    // "format-critical": "{temperatureC}°C {icon}",
    "format": "{temperatureC}°C {icon}",
    "format-icons": ["", "", ""]
  },
  "battery": {
    "cursor": false,
    "states": {
      "good": 95,
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}<span color='gray'>%</span>",
    "format-charging": " {capacity}<span color='gray'>%</span>",
    "format-plugged": "",
    "format-not-charging": "",
    "format-full": "",
    "format-alt": "{icon} {time}",
    "format-time": "{H}:{M:02d}",
    "format-icons": ["", "", "", "", ""]
  },
  "pulseaudio": {
    "cursor": false,
    "scroll-step": 5, // %, can be a float
    "format": "{volume}% {icon} {format_source}",
    "format-bluetooth": "{volume}% {icon} {format_source}",
    "format-bluetooth-muted": " {icon} {format_source}",
    "format-muted": " {format_source}",
    "format-source": "",
    "format-source-muted": "",
    "format-icons": {
      "headphone": "",
      "hands-free": "",
      "headset": "",
      "phone": "",
      "portable": "",
      "car": "",
      "hdmi": "",
      "default": ["", "", ""]
    },
    "ignored-sinks": ["Easy Effects Sink", "Bose Equalizer Sink"],
    "on-click": "pamixer --toggle-mute",
    "on-click-right": "pavucontrol"
  },
  "custom/media": {
    "cursor": false,
    "exec": "playerctl metadata -f '{{playerName}} {{lc(status)}} «{{title}} - {{artist}}»' -F",
    "on-click": "playerctl play-pause",
    "on-click-middle": "playerctl stop",
    "on-scroll-up": "playerctl previous",
    "on-scroll-down": "playerctl next",
    // indicate this can be truncated
    "max-length": 500,
    "escape": true,
    "tooltip": false,
  },
  "custom/aqi": {
    "cursor": false,
    "exec": "~/.config/waybar/scripts/aqi",
    "on-click": "~/.config/waybar/scripts/aqi open-url",
    "return-type": "json",
    "escape": true,
  },
  "custom/taskmaid": {
    "cursor": false,
    "exec": "~/.config/waybar/scripts/taskmaid eDP-1",
    "on-click-middle": "~/.config/waybar/scripts/taskmaid close",
    "return-type": "json",
    "max-length": 1500,
    "escape": true,
  },
  "custom/netspeed": {
    "exec": "~/.config/waybar/scripts/netspeed",
    "return-type": "json",
    "escape": false,
    "min-length": 12,
  },
  "custom/cpu": {
    "exec": "~/.config/waybar/scripts/cpu-psi/cpu-psi",
    "return-type": "json",
    "escape": false,
  },
}
