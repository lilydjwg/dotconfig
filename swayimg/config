[viewer]
window = #000000ff
scale = fit
position = free

[gallery]
window = #000000ff

[keys.viewer]
s = antialiasing next
Shift+s = antialiasing prev

ScrollUp = zoom +20
ScrollDown = zoom -20
w = zoom fit
z = zoom keep

Equal = zoom real
1 = zoom real
2 = zoom real; zoom +100
3 = zoom real; zoom +200
4 = zoom real; zoom +300
5 = zoom real; zoom -50

n = next_file
p = prev_file

Shift+less = rotate_left
Shift+greater = rotate_right

i = info viewer
u = info off
Alt+u = info off

g = mode gallery

[keys.gallery]
v = mode viewer
space = mode viewer

n = next_file
p = prev_file
h = prev_file
j = step_down
l = next_file
k = step_up
# ^
Shift+asciicircum = first_file
Shift+dollar = last_file
g = first_file
Shift+g = last_file

i = info gallery
u = info off
Alt+u = info off

[info]
show = no
info_timeout = 0

[list]
order = none

[font]
# swayimg doesn't do font fallback
name = 思源黑体
size = 16
color = #ffffffff

